# Copy to .env and fill in the providers you use.
# The app runs without AI keys: transcripts, action items, summaries, and PDFs
# still generate. Translation, Whisper, embeddings, Graph, and Meet sync need keys.

JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@rigora.local
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=RIGORA Admin
ALLOW_REGISTRATION=false

COMPANY_NAME=RIGORA
COMPANY_TAGLINE=Meeting Intelligence
BRAND_COLOR=#102033
DEFAULT_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# openai or gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# gemini, openai, or azure. gemini and openai accept the dashboard WebM microphone.
SPEECH_PROVIDER=gemini
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Microsoft Graph: Teams transcripts only.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER=

# Resend sends the PDF. EMAIL_FROM must be an address on a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DEFAULT_RECIPIENTS=
AUTO_EMAIL=false

# Public HTTPS URL Graph can reach, for transcript notifications.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Google Meet transcript pull. Service account JSON, plus the Workspace user to impersonate.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_DELEGATED_USER=

DATABASE_URL=postgresql+asyncpg://meeting:meeting@localhost:5432/meeting_intel
REPORTS_DIR=data/reports
